{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake Configure (Ninja)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        ".vscode-build",
        "-G",
        "Ninja",
        "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
        "-DBUILD_TESTING=OFF"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build gladiator.dll",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        ".vscode-build",
        "--target",
        "gladiator",
        "--parallel"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "CMake Configure (Ninja)"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Install gladiator.dll to E:\\Games\\q2Clean\\gladiator",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        ".vscode/install_gladiator.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "Build gladiator.dll"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Build + Install gladiator.dll",
      "dependsOn": [
        "Install gladiator.dll to E:\\Games\\q2Clean\\gladiator"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
