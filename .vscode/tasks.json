{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake Configure (Ninja)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        ".vscode-build",
        "-G",
        "Ninja",
        "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
        "-DBUILD_TESTING=OFF"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build Gladiator modules",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        ".vscode-build",
        "--target",
        "gladiator",
        "game",
        "--parallel"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "CMake Configure (Ninja)"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Install Gladiator modules",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        ".vscode/install_gladiator.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "//": "The one place the install destination is defined. install_gladiator.ps1 reads it, and no task label repeats it.",
          "GLADIATOR_INSTALL_DIR": "E:\\Games\\q2Clean\\gladiator"
        }
      },
      "dependsOn": [
        "Build Gladiator modules"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Build + Install Gladiator modules",
      "dependsOn": [
        "Install Gladiator modules"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
