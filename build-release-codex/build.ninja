build gladiator.dll gladiator.lib: C_SHARED_LIBRARY_LINKER__gladiator_Release CMakeFiles/gladiator.dir/src/botlib/common/l_assets.c.obj CMakeFiles/gladiator.dir/src/botlib/common/l_crc.c.obj CMakeFiles/gladiator.dir/src/botlib/common/l_libvar.c.obj CMakeFiles/gladiator.dir/src/botlib/common/l_log.c.obj CMakeFiles/gladiator.dir/src/botlib/common/l_memory.c.obj CMakeFiles/gladiator.dir/src/botlib/common/l_struct.c.obj CMakeFiles/gladiator.dir/src/botlib/common/l_utils.c.obj CMakeFiles/gladiator.dir/src/botlib/precomp/l_precomp.c.obj CMakeFiles/gladiator.dir/src/botlib/precomp/l_script.c.obj CMakeFiles/gladiator.dir/src/botlib/aas/aas_debug.c.obj CMakeFiles/gladiator.dir/src/botlib/aas/aas_debug_commands.c.obj CMakeFiles/gladiator.dir/src/botlib/aas/aas_cluster.c.obj CMakeFiles/gladiator.dir/src/botlib/aas/aas_main.c.obj CMakeFiles/gladiator.dir/src/botlib/aas/aas_map.c.obj CMakeFiles/gladiator.dir/src/botlib/aas/aas_move.c.obj CMakeFiles/gladiator.dir/src/botlib/aas/aas_optimize.c.obj CMakeFiles/gladiator.dir/src/botlib/aas/aas_sound.c.obj CMakeFiles/gladiator.dir/src/botlib/aas/aas_reach.c.obj CMakeFiles/gladiator.dir/src/botlib/aas/aas_route.c.obj CMakeFiles/gladiator.dir/src/botlib/ea/ea_main.c.obj CMakeFiles/gladiator.dir/src/botlib/ai/ai_character.c.obj CMakeFiles/gladiator.dir/src/botlib/ai/ai_dm.c.obj CMakeFiles/gladiator.dir/src/botlib/ai/ai_weapon.c.obj CMakeFiles/gladiator.dir/src/botlib/ai/goal_move_orchestrator.c.obj CMakeFiles/gladiator.dir/src/botlib/ai_chat/ai_chat.c.obj CMakeFiles/gladiator.dir/src/botlib/ai_character/bot_character.c.obj CMakeFiles/gladiator.dir/src/botlib/ai_goal/ai_goal.c.obj CMakeFiles/gladiator.dir/src/botlib/ai_goal/bot_goal.c.obj CMakeFiles/gladiator.dir/src/botlib/ai_move/ai_move.c.obj CMakeFiles/gladiator.dir/src/botlib/ai_move/bot_move.c.obj CMakeFiles/gladiator.dir/src/botlib/ai_move/mover_catalogue.c.obj CMakeFiles/gladiator.dir/src/botlib/ai_weight/ai_weight.c.obj CMakeFiles/gladiator.dir/src/botlib/ai_weight/bot_weight.c.obj CMakeFiles/gladiator.dir/src/botlib/ai_weapon/bot_weapon.c.obj CMakeFiles/gladiator.dir/src/botlib/interface/bot_interface.c.obj CMakeFiles/gladiator.dir/src/botlib/interface/bot_state.c.obj CMakeFiles/gladiator.dir/src/botlib/interface/botlib_interface.c.obj | src/botlib/interface/botlib_interface.lib src/botlib/common/botlib_common.lib src/botlib/precomp/botlib_precomp.lib src/botlib/aas/botlib_aas.lib src/botlib/ai/botlib_ai.lib src/botlib/ea/botlib_ea.lib src/q2bridge/q2bridge.lib src/botlib/common/botlib_common.lib || src/botlib/aas/botlib_aas.lib src/botlib/ai/botlib_ai.lib src/botlib/common/botlib_common.lib src/botlib/ea/botlib_ea.lib src/botlib/interface/botlib_interface.lib src/botlib/precomp/botlib_precomp.lib src/q2bridge/q2bridge.lib
  CONFIG = Release
  LANGUAGE_COMPILE_FLAGS = -O3 -DNDEBUG -D_DLL -D_MT -Xclang --dependent-lib=msvcrt
  LINK_FLAGS = -shared -fuse-ld=lld-link
  LINK_LIBRARIES = src/botlib/interface/botlib_interface.lib  src/botlib/common/botlib_common.lib  src/botlib/precomp/botlib_precomp.lib  src/botlib/aas/botlib_aas.lib  src/botlib/ai/botlib_ai.lib  src/botlib/ea/botlib_ea.lib  src/q2bridge/q2bridge.lib  src/botlib/common/botlib_common.lib  -lkernel32 -luser32 -lgdi32 -lwinspool -lshell32 -lole32 -loleaut32 -luuid -lcomdlg32 -ladvapi32 -loldnames
  OBJECT_DIR = CMakeFiles\gladiator.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  RESTAT = 1
  TARGET_COMPILE_PDB = CMakeFiles\gladiator.dir\
  TARGET_FILE = gladiator.dll
  TARGET_IMPLIB = gladiator.lib
  TARGET_PDB = gladiator.pdb
  TARGET_SUPPORT_DIR = CMakeFiles\gladiator.dir


